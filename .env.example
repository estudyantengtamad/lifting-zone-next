# =============================================================================
# Lifting Zone Obrero — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Site & Deployment URLs (For Vercel & Supabase Auth Redirects)
# -----------------------------------------------------------------------------
# Local: http://localhost:3000 | Production: https://liftingzonebutuan.vercel.app
NEXT_PUBLIC_SITE_URL=https://liftingzonebutuan.vercel.app

# -----------------------------------------------------------------------------
# 1. Supabase Credentials (Project Settings > API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only service role key (Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# -----------------------------------------------------------------------------
# 2. PayMongo QR Ph Payment Gateway (Dashboard > Developers > API Keys & Webhooks)
# -----------------------------------------------------------------------------
# Secret key starting with sk_test_ or sk_live_ (Server-only)
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
# Webhook signing secret starting with whsk_ (used to verify HMAC signatures)
PAYMONGO_WEBHOOK_SECRET=whsk_your-paymongo-webhook-secret

# -----------------------------------------------------------------------------
# 3. Google Cloud OAuth & Gmail API (Google Cloud Console > Credentials)
# -----------------------------------------------------------------------------
# OAuth 2.0 Web Client ID
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# OAuth 2.0 Web Client Secret
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# Long-lived Refresh Token with scope: https://www.googleapis.com/auth/gmail.send
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
# The store's verified Gmail address used as sender
GMAIL_SENDER_ADDRESS=orders@liftingzone.ph
# The display name on outgoing receipts
GMAIL_SENDER_NAME=Lifting Zone Obrero

# -----------------------------------------------------------------------------
# 4. Optional Backend Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
